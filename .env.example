# Postgres init — only applied when the pgdata volume is first created.
# Changing these later requires: docker compose down -v
POSTGRES_USER=backend
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tinylink_dev
# App -> database. Host and Port are set in compose.yaml for the container network.
Database__Name=tinylink_dev
Database__User=backend
Database__Password=change-me
# Required at startup. 32+ bytes, base64:  openssl rand -base64 32
ShortCodes__Key=

