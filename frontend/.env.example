# Dev only: copy to .env (gitignored) and `npm run dev`.
# The Vite proxy forwards /api and /healthz to the API, so VITE_API_BASE_URL
# stays empty. VITE_REDIRECT_BASE_URL must be the API origin itself — browsers
# follow the 302, and the Vite dev server does not serve redirects.
#
# Production (Docker) builds set neither variable: the SPA is served by the API
# from the same origin, so both default to the page origin and no CORS applies.
# For a split-origin deploy instead, bake the API origin in at image build time:
#   docker build --build-arg VITE_API_BASE_URL=https://api.example.com .
VITE_API_BASE_URL=
VITE_REDIRECT_BASE_URL=http://api.localhost
