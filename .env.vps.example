# Copy to ~/tinylink/.env on the VPS and fill in. Never commit.
# DOMAIN is the public hostname Traefik routes to TinyLink.
DOMAIN=tinylink.example.com

# Shared Postgres (the "db" container). The tinylink role + database
# already exist there; only the password goes here.
Database__Host=db
Database__Port=5432
Database__Name=tinylink
Database__User=tinylink
Database__Password=change-me

# Required at startup. Generated once on the server, never change.
ShortCodes__Key=change-me
